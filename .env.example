# VLMB Music Bot runtime secrets. Copy to /root/MusBot/.env and chmod 600.
# Do NOT commit the real file.
TELEGRAM_BOT_TOKEN=PUT_NEW_TELEGRAM_BOT_TOKEN_HERE
YANDEX_TOKEN=PUT_YANDEX_TOKEN_HERE
VK_TOKEN=
LASTFM_API_KEY=PUT_LASTFM_API_KEY_HERE
REDIS_URL=redis://localhost:6379/0

# Optional: custom lock path. Empty = /tmp/vlmb_music_bot.lock
INSTANCE_LOCK_FILE=
